{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [
        "AGENTS.md",
        ".context/CONVENTIONS.md"
    ],
    "mcp": {
        "context7": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp"
            ],
            "enabled": true
        }
    },
    "agent": {
        "plan": {
            "model": "omniroute/app-architect",
            "permission": {
                "edit": "deny",
                "bash": "deny"
            }
        },
        "build": {
            "model": "omniroute/app-architect"
        },
        "explore": {
            "model": "omniroute/fast-builder",
            "permission": {
                "context7*": "deny",
                "edit": "deny",
                "bash": "deny"
            }
        }
    }
}